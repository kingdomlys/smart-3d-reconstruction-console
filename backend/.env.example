# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Data
# TASKS_ROOT can be absolute or relative to the repository root.
TASKS_ROOT=./data/tasks
MAX_UPLOAD_FILES=8
MAX_IMAGE_PIXELS=2073600
MAX_IMAGE_LONG_EDGE=1920

# Optional: TripoSR worker python path override
# TRIPOSR_PY=C:/path/to/triposr/python.exe

# Optional: TripoSR command line hook used by backend/pipelines/triposr.
# TRIPOSR_CMD=python backend/workers/triposr_infer.py
# TRIPOSR_REPO=third_party/TripoSR
# TRIPOSR_DEVICE=cuda:0

# Optional: enable/disable rembg preprocessing
# USE_REMBG=1

# Optional: COLMAP command hook used by backend/pipelines/colmap.
# Expects --input-dir and --output-dir.
# COLMAP_CMD=python backend/workers/colmap_pipeline.py
# COLMAP_BIN=colmap

# Optional: 3DGS command hook used by backend/pipelines/gaussian_splatting.
# Expects --interim-dir, --output-dir, and --iterations.
# DGS_CMD=python backend/workers/gsplat_pipeline.py
# DGS_TRAIN_SCRIPT=path/to/train.py
# DGS_ITERATIONS=1000
